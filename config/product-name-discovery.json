{
  "_about": "제품·회사 이름 후보 표(scripts/product-name-candidates.mjs, 남헌 v48 §2-B 단계 1)의 불용어·제외 목록·임계값. 코드는 이 파일을 읽기만 한다. 값은 2026-10-12 초기값이다 — 실데이터로 보정하지 않았다(첫 --run 결과를 보고 고친다).",
  "rule_ver": "pnc-v2",
  "_rule_ver_history": "pnc-v1(2026-10-12 초기) → pnc-v2(2026-10-12, 남헌 v52 §1-3: 첫 --run 채택 41건의 오탐을 exclude 6갈래로 분리 · 영역별 표 · 승인 시트).",

  "_exclude": "채택 전에 기각하는 목록(정규화 키 기준, 대장에 사유와 함께 남는다). 키가 곧 기각 사유다. acronym 만 조건부 — acronym_rule.exempt_signals(앱 링크·도메인) 신호가 있으면 통과한다. 나머지 다섯은 무조건 기각. 2026-10-12 첫 --run 채택 41건에서 사람이 오탐으로 짚은 것 + 같은 결의 흔한 것.",
  "exclude": {
    "acronym": ["adhd", "mrr", "arr", "api", "apis", "crm", "crms", "pkm", "vps", "rss", "sso", "seo", "roi", "sdk", "sdks", "ldac", "nasa", "msl", "ktf", "stx", "kpi", "kpis", "okr", "okrs", "llm", "llms", "gdpr", "hipaa", "smb", "smbs", "erp", "cms", "ats", "hris", "ltv", "cac", "nps", "arpu", "mau", "dau", "usb", "nfc", "gps", "faq", "irs", "fda", "usps"],
    "general_noun": ["spanish", "french", "german", "italian", "portuguese", "japanese", "chinese", "russian", "hindi", "arabic", "dutch", "canada", "india", "germany", "france", "brazil", "mexico", "australia", "uk", "eu", "london", "berlin", "academy", "tel", "blasting", "hi", "hello", "hey", "tiger", "dear", "sir", "mom", "dad"],
    "site_ui": ["askhn", "showhn", "tellhn", "launchhn", "hnwhoishiring", "whoishiring"],
    "tool_not_target": ["claudecode", "codex", "openaicodex", "cursor", "windsurf", "aider", "devin", "geminicli", "githubcopilot", "sonnet", "opus", "haiku", "gpt4", "gpt4o", "gpt5", "o1", "o3", "mistral", "deepseek", "perplexity", "midjourney"],
    "hardware": ["applepencil", "applewatch", "airpods", "airpodspro", "airtag", "magickeyboard", "magicmouse", "magictrackpad", "macbook", "macbookpro", "macbookair", "imac", "ipadpro", "ipadair", "ipadmini", "visionpro", "kindle", "pixelwatch", "galaxywatch", "galaxybuds", "surfacepro", "raspberrypi", "steamdeck"],
