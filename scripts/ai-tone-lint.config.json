{
  "_note": "ai-tone-lint 기준값. 값만 바꾸면 판정이 바뀐다. style_spec 파일이 있으면 그 voice 값(override.voice 우선)이 targets 의 da_pct·question_pct·median_len·max_len·emoji_max 를 덮는다. 정규식은 JS 문자열(역슬래시 두 번).",
  "style_spec": "reports/2026-10-15/ig-style-spec.json",
  "targets": {
    "da_pct": [80, 93],
    "question_pct": [0, 8],
    "noun_phrase_max": 6,
    "noun_phrase_max_chars": 20,
    "contrast_max": 2,
    "median_len": [19, 28],
    "max_len": 60,
    "quote_max_chars": 130,
    "emoji_max": 0,
    "emdash_max": 2,
    "triad_max": 2,
    "summary_paragraph_max": 2,
    "rago_run_max": 2,
    "rhythm_run_max": 2,
    "rhythm_min_sentences": 2,
    "rhythm_len_buckets": [15, 30]
  },
  "severity": {
    "no_sentences": "fail",
    "da_ratio": "fail",
    "polite_mix": "warn",
    "question": "fail",
    "noun_phrase": "warn",
    "contrast": "fail",
    "median_len": "fail",
    "long_sentence": "warn",
    "banned": "warn",
    "summary_repeat": "warn",
    "rago_run": "warn",
    "emoji": "warn",
    "emdash": "warn",
    "triad": "warn",
    "rhythm": "warn",
    "meta_leak": "fail",
    "quote_len": "fail",
    "quote_source": "warn",
    "pii": "fail",
    "typo": "warn"
  },
  "banned": [
    { "re": "이렇게\\s?보면", "label": "이렇게 보면" },
    { "re": "돌아보면", "label": "돌아보면" },
    { "re": "그렇다면", "label": "그렇다면" },
    { "re": "결국", "label": "결국" },
    { "re": "라고\\s?읽힌다", "label": "~라고 읽힌다" },
    { "re": "라고\\s?볼\\s?수\\s?있다", "label": "~라고 볼 수 있다" },
    { "re": "중요한\\s?것은", "label": "중요한 것은" },
    { "re": "의\\s?시대", "label": "~의 시대" },
    { "re": "혁신적인", "label": "혁신적인" },
    { "re": "게임\\s?체인저", "label": "게임 체인저" },
    { "re": "한\\s?마디로", "label": "한 마디로" },
    { "re": "정리하자면", "label": "정리하자면" }
  ],
  "summary_openers": ["결국", "즉", "요컨대", "정리하면", "정리하자면", "이처럼", "이렇게", "한마디로", "한 마디로", "결론적으로"],
  "rago_re": "라고\\s?썼다",
  "meta": [
    { "re": "독자\\s?:", "label": "독자:" },
    { "re": "판단\\s?이유\\s?:", "label": "판단 이유:" },
    { "re": "근거\\s?세기", "label": "근거 세기" },
    { "re": "근거\\s?등급", "label": "근거 등급" },
    { "re": "\\[(?:근거|확신)[^\\]]*\\]", "label": "근거·확신 배지" },
    { "re": "확신도", "label": "확신도" },
    { "re": "\\[예시 데이터\\]", "label": "[예시 데이터]" },
    { "re": "TODO", "label": "TODO" },
    { "re": "XXX", "label": "XXX" },
    { "re": "확인\\s?못\\s?함", "label": "확인 못 함" },
    { "re": "확인되지\\s?않는다", "label": "확인되지 않는다" },
    { "re": "확인\\s?불가", "label": "확인 불가" }
  ],
  "quote_source": [
    { "re": "구글\\s?플레이|google\\s?play|플레이\\s?스토어", "label": "구글 플레이" },
    { "re": "앱\\s?스토어|app\\s?store", "label": "앱스토어" },
    { "re": "[가-힣A-Za-z0-9_]+님", "label": "~님(닉네임)" },
    { "re": "@[A-Za-z0-9_.]+", "label": "@아이디" },
    { "re": "\\d{4}\\s?[.\\-/]\\s?\\d{1,2}\\s?[.\\-/]\\s?\\d{1,2}|\\d{1,2}월\\s?\\d{1,2}일", "label": "날짜" },
    { "re": "다나와|쿠팡|네이버|리뷰어", "label": "플랫폼명" }
  ],
  "pii": [
    { "re": "[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+\\.[A-Za-z0-9.-]+", "label": "이메일" },
    { "re": "01[016789][-.\\s]?\\d{3,4}[-.\\s]?\\d{4}", "label": "휴대전화" },
    { "re": "(?<!\\d)0\\d{1,2}-\\d{3,4}-\\d{4}(?!\\d)", "label": "전화번호" }
  ],
  "typos": [
    { "re": "되요", "fix": "돼요" },
    { "re": "(?<![가-힣])안(되|돼|됐)", "fix": "안 돼 / 안 된다 (형용사 '안되다(가엾다)'면 무시)" },
    { "re": "몇일", "fix": "며칠" },
    { "re": "바램", "fix": "바람" },
    { "re": "설레임", "fix": "설렘" }
  ]
}
